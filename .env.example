# Необязательные настройки. Храните реальные ключи только в локальном .env, не в коде клиента.
PORT=4173
# HOST=127.0.0.1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Каталог из фидов магазинов
# Кто может подключать фиды (через запятую). Если пусто — администратор первый зарегистрированный пользователь.
ADMIN_EMAILS=
# Как часто сервер перезагружает фиды по ссылке, часов
FEED_REFRESH_HOURS=24
